<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>passQL</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>passQL</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>GIDClientID</key>
	<string>662424763183-7e27721u2hpq32d1jffb106d5532hgvd.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.662424763183-7e27721u2hpq32d1jffb106d5532hgvd</string>
			</array>
		</dict>
		<!-- 카카오 로그인 리다이렉트 kakao{네이티브 앱 키} (값은 Flutter/Debug·Release.xcconfig, 실제 값은 app/.env > SocialLogin.xcconfig) -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kakao$(KAKAO_NATIVE_APP_KEY)</string>
			</array>
		</dict>
		<!-- 네이버 앱 로그인 복귀 스킴 (NidUrlScheme 과 같은 값, 네이버 개발자 센터 iOS URL Scheme 에 등록) -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>passqlnaver</string>
			</array>
		</dict>
		<!-- GitHub 로그인 콜백 passql://auth/callback/github (서버 redirect 허용 목록과 같은 주소) -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>passql</string>
			</array>
		</dict>
	</array>
	<!-- 카카오톡·네이버 앱 설치 확인과 앱 로그인 호출 -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakaokompassauth</string>
		<string>kakaolink</string>
		<string>naversearchapp</string>
		<string>naversearchthirdlogin</string>
	</array>
	<!-- 네이버 로그인 SDK 설정 (값은 Flutter/Debug·Release.xcconfig, 실제 값은 app/.env > SocialLogin.xcconfig) -->
	<key>NidUrlScheme</key>
	<string>passqlnaver</string>
	<key>NidClientID</key>
	<string>$(NAVER_CLIENT_ID)</string>
	<key>NidClientSecret</key>
	<string>$(NAVER_CLIENT_SECRET)</string>
	<key>NidAppName</key>
	<string>$(NAVER_CLIENT_NAME)</string>
	<!-- AdMob 앱 ID. 값은 Flutter/Debug·Release.xcconfig (실제 값은 app/.env > AdMob.xcconfig) -->
	<key>GADApplicationIdentifier</key>
	<string>$(PASSQL_ADMOB_IOS_APP_ID)</string>
	<!-- 사진 선택(의견 첨부): image_picker 는 PHPicker 라 권한 팝업 없이 고른 사진만 받음, 심사용 사용 목적 문구 -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>의견에 첨부할 사진을 고르는 데 사용돼요. 고른 사진만 업로드돼요.</string>
	<!-- 추적 허용(ATT) 팝업 안내 문구 -->
	<key>NSUserTrackingUsageDescription</key>
	<string>맞춤형 광고를 보여 드리는 데 사용돼요. 허용하지 않아도 모든 기능을 그대로 쓸 수 있어요.</string>
	<!-- Google 광고 성과 측정용 SKAdNetwork 식별자 -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
