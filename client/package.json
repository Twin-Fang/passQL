{
  "name": "client",
  "private": true,
  "version": "1.77.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:architecture && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run test:architecture",
    "test:architecture": "node --test --test-name-pattern=client- test/architecture/architecture.rules.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "gen:api": "openapi-typescript ../api-contract/openapi.json --properties-required-by-default -o src/types/generated/openapi.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.105.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.12",
    "daisyui": "5.7.50",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
